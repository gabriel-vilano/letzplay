# Supabase — credenciais PÚBLICAS do projeto
# Dashboard do Supabase → Project Settings → API Keys (use a publishable key, sb_publishable_…)
# Nunca a secret key (sb_secret_…) nem a service_role: toda variável NEXT_PUBLIC_*
# vai parar no JavaScript enviado ao navegador (o build bloqueia se detectar segredo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
